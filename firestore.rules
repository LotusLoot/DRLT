rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 성장 기록과 닉네임: 본인만 읽고 쓸 수 있음
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 친구 순위: 누구나 읽고, 본인 기록만 씀 (모양이 이상한 기록은 거절)
    match /scores/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'bestMist', 'bestTime', 'wins', 'runs', 'kills', 'reach', 'forms', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 16
        && request.resource.data.bestMist is int && request.resource.data.bestMist >= -1 && request.resource.data.bestMist <= 10
        && request.resource.data.bestTime is int && request.resource.data.bestTime >= 0
        && request.resource.data.runs is int && request.resource.data.runs >= 0
        && request.resource.data.reach is int && request.resource.data.reach >= 0 && request.resource.data.reach <= 50
        && request.resource.data.forms is list && request.resource.data.forms.size() <= 3;
    }
  }
}
